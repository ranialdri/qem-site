# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Mot de passe pour accéder à l'espace administrateur des soumissions QEM.
# Par défaut en mode initial : QEM2026! (modifiable dans les variables d'environnement).
ADMIN_PASSWORD="QEM2026!"

# CONFIGURATION COURRIEL AUTOMATIQUE (qassi.menagepro@gmail.com)
# Pour envoyer directement les demandes de soumission (avec photos en pièces jointes)
# ainsi qu'un courriel de confirmation automatique au client via Gmail SMTP :
# Créez un "Mot de passe d'application" (16 caractères) dans le compte Google qassi.menagepro@gmail.com
# (Compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications)
# et ajoutez-le dans le panneau Secrets de AI Studio sous le nom GMAIL_APP_PASSWORD.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="qassi.menagepro@gmail.com"
GMAIL_APP_PASSWORD=""


